{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build GameHub",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++11",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-g",
                "main.cpp",
                "Inventory.cpp",
                "Storage.cpp",
                "Input.cpp",
                "-o",
                "${workspaceFolder}\\gamehub.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },

        { // MSYS2 build task
            "label": "Build GameHub",
            "type": "process", // bypass cmd.exe as it combines -pedantic-g
            "command": "D:/msys64/ucrt64/bin/g++.exe",
            "args": [
                //"-fdiagnostics-color=always",
                "-std=c++11",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-g",
                "main.cpp",
                "Inventory.cpp",
                "Storage.cpp",
                "Input.cpp",
                "-o",
                "gamehub.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "D:/msys64/ucrt64/bin;${env:PATH}"
                }
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ],
    "version": "2.0.0"
}